{
  "manifest_version": 3,
  "name": "Maya Standup Timer",
  "short_name": "Maya Timer",
  "version": "1.1.0",
  "description": "Keep standups moving with Maya, a lively animated timekeeper who stays over your meeting or board.",
  "permissions": ["activeTab", "scripting", "storage"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Show Maya Standup Timer",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
