{
  "name": "maya-standup-timer",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "extension:package": "node scripts/package-extension.mjs",
    "extension:verify": "node scripts/package-extension.mjs --verify-only",
    "preview": "vite preview",
    "test": "node --test tests/timer.test.mjs tests/extension.test.mjs tests/extension-package.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "vite": "6.4.2",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {}
}
